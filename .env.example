# Copie para .env e preencha (o .env nunca é commitado)
ANTHROPIC_API_KEY=
# Opcional: envio de candidaturas por e-mail (Gmail -> Conta Google > Segurança > Senhas de app)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Opcional: ReliefWeb exige um "appname" pré-aprovado (https://apidoc.reliefweb.int/parameters#appname)
RELIEFWEB_APPNAME=
